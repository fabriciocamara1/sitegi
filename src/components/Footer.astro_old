---
const ano = new Date().getFullYear();
---
<footer class="site-footer">
  <p>&copy; {ano} Nome do Site — Conteúdo informativo sobre nutrição infantil.</p>
  <p class="footer-note">Este site não substitui acompanhamento profissional individualizado.</p>
</footer>

<style>
  .site-footer {
    padding: 2rem;
    text-align: center;
    font-size: 0.85rem;
    color: #777;
    border-top: 1px solid #eee;
    margin-top: 3rem;
  }
  .footer-note {
    margin-top: 0.3rem;
  }
</style>
