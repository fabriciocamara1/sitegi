---
const ano = new Date().getFullYear();

// Preencha com os dados reais de cada local de atendimento
const locais = [
  {
    id: '1',
    nome: 'Magé',
    endereco: 'Dr. Siqueira 296, Centro - Magé - Shopping da Praça - Sala 507',
    telefone: '(21) 98861-0462',
  },
  {
    id: '2',
    nome: 'Santo Aleixo',
    endereco: 'Rua Bom Jardim - 880 - Santo Aleixo - Magé - Espaço PlenaMente ',
    telefone: '(21) 98861-0462',
  },
];
---
<footer class="site-footer">
  <div class="conteudo">
    <div class="bloco locais">
      <h3>Atendimento e consultas</h3>

      <div class="tabs" role="tablist">
        {locais.map((local, i) => (
          <button
            type="button"
            class="tab-local"
            class:list={[{ ativo: i === 0 }]}
            data-local={local.id}
          >
            {local.nome}
          </button>
        ))}
      </div>

      {locais.map((local) => (
        <div class="local-info" data-local-info={local.id}>
          <p>{local.endereco}</p>
          <p>{local.telefone}</p>
        </div>
      ))}

      <p class="email">gisellepg@gmail.com.br</p>
    </div>

    <div class="bloco">
      <h3>Navegação</h3>
      <ul>
        <li><a href="/quem-sou-eu">Quem sou eu</a></li>
        <li><a href="/blog">Artigos</a></li>
        <li><a href="/receitas">Receitas</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
    </div>
  </div>
  <div class="copyright">
    <p>&copy; {ano} Giselle Câmara Nutricionista — Conteúdo informativo sobre nutrição infantil.</p>
    <p class="footer-note">Este site não substitui acompanhamento profissional individualizado.</p>
  </div>
</footer>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('.tab-local');
  const infos = document.querySelectorAll<HTMLElement>('[data-local-info]');

  function ativar(id: string) {
    infos.forEach((el) => {
      el.hidden = el.dataset.localInfo !== id;
    });
    botoes.forEach((btn) => {
      btn.classList.toggle('ativo', btn.dataset.local === id);
    });
  }

  botoes.forEach((btn) => {
    btn.addEventListener('click', () => ativar(btn.dataset.local ?? '1'));
  });

  // Ativa o primeiro local por padrão (só roda se o JS carregar;
  // sem JS, os dois locais permanecem visíveis por padrão)
  if (botoes.length > 0) {
    ativar(botoes[0].dataset.local ?? '1');
  }
</script>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--cor-verde-escuro);
    color: white;
  }
  .conteudo {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .bloco h3 {
    font-family: var(--fonte-titulo);
    color: white;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }
  .bloco p {
    margin: 0.3rem 0;
    font-size: 0.9rem;
    opacity: 0.9;
  }
  .bloco ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bloco li {
    margin-bottom: 0.4rem;
  }
  .bloco a {
    color: white;
    text-decoration: none;
    font-size: 0.9rem;
    opacity: 0.9;
  }
  .bloco a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .tab-local {
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }
  .tab-local.ativo {
    background: var(--cor-rosa);
    border-color: var(--cor-rosa);
  }
  .local-info {
    margin-bottom: 0.5rem;
  }
  .email {
    margin-top: 0.75rem;
  }

  .copyright {
    text-align: center;
    padding: 1.25rem;
    font-size: 0.8rem;
    background: rgba(0,0,0,0.15);
  }
  .copyright p {
    margin: 0.2rem 0;
  }
</style>