---
import { Image } from 'astro:assets';
import logo from '../images/logo.png';


const links = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Artigos' },
  { href: '/receitas', label: 'Receitas' },
  { href: '/glossario', label: 'Glossário' },
  { href: '/quando-buscar-ajuda', label: 'Quando buscar ajuda' },
  { href: '/faq', label: 'FAQ' },
];
---
<header class="site-header">
  <nav>
    <a href="/" class="logo">
        <Image src={logo} alt="Giselle Câmara Nutricionista" width={140} height={40} />
    </a>
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    padding: 1rem 2rem;
    border-bottom: 1px solid #eee;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
    .logo img {
    height: 110px;
    width: auto;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
    color: #444;
  }
  a:hover {
    color: #3a6b52;
  }
</style>
