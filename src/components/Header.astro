---
import { Image } from 'astro:assets';
import logo from '../images/logo.png';

const links = [
  { href: '/', label: 'Início' },
  { href: '/quem-sou-eu', label: 'Quem sou eu' },
  { href: '/blog', label: 'Artigos' },
  { href: '/receitas', label: 'Receitas' },
  { href: '/glossario', label: 'Glossário' },
  { href: '/quando-buscar-ajuda', label: 'Quando buscar ajuda' },
  { href: '/faq', label: 'FAQ' },
];
---
<header class="site-header">
  <nav>
    <a href="/" class="logo">
      <Image src={logo} alt="Giselle Câmara Nutricionista" width={220} height={120} />
    </a>
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    padding: 1rem 2rem;
    border-bottom: 3px solid var(--cor-verde-claro);
    background: white;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .logo :global(img) {
    height: 120px;
    width: auto;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  a {
    text-decoration: none;
    color: var(--cor-texto);
    font-weight: 600;
    font-size: 0.95rem;
  }
  a:hover {
    color: var(--cor-rosa);
  }
</style>
