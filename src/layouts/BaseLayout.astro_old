---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descricao?: string;
}

const { titulo, descricao = 'Acolhimento e orientação sobre nutrição infantil.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descricao} />
    <title>{titulo} | Nome do Site</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --cor-principal: #3a6b52;
    --cor-fundo: #fffdf9;
    --cor-texto: #2b2b2b;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.6;
  }
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }
  h1, h2, h3 {
    color: var(--cor-principal);
    text-align: center;
  }
</style>
