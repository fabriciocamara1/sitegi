---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descricao?: string;
}

const { titulo, descricao = 'Acolhimento e orientação sobre nutrição infantil.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descricao} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&family=Nunito+Sans:wght@400;600;700&family=Pacifico&display=swap"
      rel="stylesheet"
    />
    <title>{titulo} | Giselle Câmara Nutricionista</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* Paleta extraída da logo */
    --cor-verde-escuro: #4a933d;
    --cor-verde: #6eab48;
    --cor-verde-claro: #88b243;
    --cor-rosa: #ef688d;
    --cor-rosa-escuro: #e7617b;
    --cor-coral: #e05b41;

    /* Uso semântico */
    --cor-principal: var(--cor-verde-escuro);
    --cor-secundaria: var(--cor-rosa);
    --cor-acento: var(--cor-coral);
    --cor-fundo: #fffdf9;
    --cor-texto: #333333;

    /* Fontes */
    --fonte-titulo: 'Baloo 2', system-ui, sans-serif;
    --fonte-destaque: 'Pacifico', cursive;
    --fonte-corpo: 'Nunito Sans', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--fonte-corpo);
    background: var(--cor-fundo) url('../images/background_site.png') center top / cover fixed no-repeat;
    color: var(--cor-texto);
    line-height: 1.6;
  }
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }
  h1, h2, h3 {
    font-family: var(--fonte-titulo);
    color: var(--cor-principal);
  }
</style>
